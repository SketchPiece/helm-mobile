+//export TsnetRebind
+func TsnetRebind(sd C.int) C.int {
+	s := getServer(sd)
+	if s == nil {
+		return C.EBADF
+	}
+	if !s.started {
+		return s.recErr(fmt.Errorf("tailscale_rebind: server not started"))
+	}
+	conn, ok := s.s.Sys().MagicSock.GetOK()
+	if !ok {
+		return s.recErr(fmt.Errorf("tailscale_rebind: no magicsock"))
+	}
+	conn.Rebind()
+	go conn.ReSTUN("tailscale_rebind")
+	return 0
+}
