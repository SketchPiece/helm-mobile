    },
    "The new thread opens, so you can follow the agent.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый тред открывается, и можно следить за агентом."
          }
        }
      }
    },
    "The pairing code was rejected. Codes work once and expire after 5 minutes.": {
      "localizations": {
